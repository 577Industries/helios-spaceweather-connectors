# NASA Earthdata Login — required for CDDIS GIM downloads
# Register at https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# NASA API key — required for some DONKI endpoints (DEMO_KEY works for low volume)
NASA_API_KEY=DEMO_KEY

# Optional override for local cache root (default: ~/.cache/helios-connectors)
HELIOS_CACHE_ROOT=
